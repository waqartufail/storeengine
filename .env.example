POSTGRES_DB=storedb
POSTGRES_USER=storeuser
# Use a unique alphanumeric database password of at least 24 characters.
POSTGRES_PASSWORD=
Owner__Email=
# Choose 12 to 128 characters. Quote values containing Compose special characters.
Owner__Password=
WEB_PORT=5173
Cookies__Secure=false
# Optional legacy fallback. You can save the token directly in Admin > Courier Configuration.
# Replace 42 with the store ID displayed on the owner dashboard.
# PostEx__Stores__42__Token=

# For a GitHub Pages store connected to this API, set the public storefront origin.
# Pages__Origin=https://YOUR-ACCOUNT.github.io

# For phone testing on trusted Wi-Fi, use 0.0.0.0 and your computer's LAN address.
WEB_BIND_ADDRESS=127.0.0.1
